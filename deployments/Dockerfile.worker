# Husky Worker —— 后台任务进程镜像
#
# 与 API 镜像的区别：worker 不需要前端产物，因此跳过了 web-build，
# 镜像更小、构建更快（约省掉一次 npm ci + vite build）。
FROM golang:1.24-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o worker ./cmd/worker

FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata \
    && adduser -D -H -u 10001 husky

WORKDIR /app

COPY --from=builder /app/worker .

USER 10001

# 镜像内不带 config.yaml：启动时若找不到配置文件会自动回退到环境变量
ENTRYPOINT ["./worker"]
# 默认参数。K8s Deployment 里用 args 覆写（例如加 -wait-lock 走多副本 HA）
CMD ["-interval", "60s"]
